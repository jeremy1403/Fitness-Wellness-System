APP_NAME="Fitness & Wellness"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000
API_VERSION=1.0.0

FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=fitness_wellness
DB_USERNAME=fw_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# MySQL container initialization (read via docker-compose env_file)
# These MUST match the DB_* values above
MYSQL_ROOT_PASSWORD=rootsecret
MYSQL_DATABASE=fitness_wellness
MYSQL_USER=fw_user
MYSQL_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000,127.0.0.1:3000,127.0.0.1:8000

MAILPIT_PORT=8025

VITE_APP_NAME="${APP_NAME}"
